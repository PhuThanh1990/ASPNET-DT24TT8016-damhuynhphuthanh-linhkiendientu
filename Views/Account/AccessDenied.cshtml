@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container">
    <div class="empty-state my-5">
        <div class="empty-icon">🔒</div>
        <p class="error-code">Lỗi 403</p>
        <h1 class="h4 text-body mb-2">Bạn không có quyền xem trang này</h1>
        <p class="mb-4">
            Tài khoản của bạn không được phép mở nội dung này. Nếu bạn cho rằng đây là nhầm lẫn,
            hãy liên hệ quản trị viên của cửa hàng.
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
            <a class="btn btn-outline-secondary" asp-controller="Product" asp-action="Index">Xem sản phẩm</a>
        </div>
    </div>
</div>
