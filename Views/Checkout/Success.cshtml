@model CustomerOrderDetailViewModel
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container">

    <div class="order-success-banner text-center bg-white border rounded-3 p-4 p-lg-5 mb-4">
        <div class="order-success-icon mb-3">✓</div>
        <h1 class="h4 fw-bold mb-2">Đặt hàng thành công!</h1>
        <p class="text-muted mb-3">
            Cảm ơn bạn đã mua hàng. Shop sẽ liên hệ xác nhận đơn trong thời gian sớm nhất.
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-3 mb-4">
            <div>
                <div class="product-meta">Mã đơn hàng</div>
                <div class="fw-bold fs-5">@Model.OrderCode</div>
            </div>
            <div>
                <div class="product-meta">Tổng tiền</div>
                <div class="fw-bold fs-5 text-danger">@Model.TotalAmount.ToVnd()</div>
            </div>
            <div>
                <div class="product-meta">Trạng thái</div>
                <div><span class="badge @Model.StatusBadgeClass fs-6">@Model.StatusText</span></div>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-primary" asp-area="" asp-controller="Order" asp-action="Details" asp-route-id="@Model.Id">
                Xem đơn hàng
            </a>
            <a class="btn btn-outline-secondary" asp-area="" asp-controller="Product" asp-action="Index">
                Tiếp tục mua sắm
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-5">
            <div class="bg-white border rounded-3 p-3 p-lg-4 h-100">
                <h2 class="h6 fw-bold mb-3">Thông tin nhận hàng</h2>
                <partial name="_OrderShipping" model="Model" />
            </div>
        </div>

        <div class="col-12 col-lg-7">
            <div class="bg-white border rounded-3 p-3 p-lg-4 h-100">
                <h2 class="h6 fw-bold mb-3">Sản phẩm đã đặt</h2>
                <partial name="_OrderLines" model="Model" />
            </div>
        </div>
    </div>

</div>
