@model CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-area="" asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
        </ol>
    </nav>

    <div class="section-head">
        <div>
            <h1 class="section-title">Thanh toán</h1>
            <p class="section-subtitle">Kiểm tra thông tin nhận hàng trước khi đặt</p>
        </div>
    </div>

    @* Giỏ hàng vừa được đối chiếu lại với kho khi mở trang này. *@
    @if (Model.Cart.Notices.Count > 0)
    {
        <div class="alert alert-warning">
            <p class="fw-semibold mb-2">Đơn hàng vừa có thay đổi, vui lòng kiểm tra lại trước khi đặt:</p>
            <ul class="mb-0 ps-3">
                @foreach (var notice in Model.Cart.Notices)
                {
                    <li>@notice</li>
                }
            </ul>
        </div>
    }

    <form asp-area="" asp-controller="Checkout" asp-action="Index" method="post" data-submit-once>
        @* Lỗi nghiệp vụ do IOrderService trả về (hết hàng, sản phẩm ngừng bán...) hiện ở đây. *@
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-4">

            <!-- Thông tin nhận hàng -->
            <div class="col-12 col-lg-7">
                <div class="panel">
                    <h2 class="h6 fw-bold mb-3">Thông tin nhận hàng</h2>

                    @* ADDR-03 — sổ địa chỉ. Chỉ gửi lên SelectedAddressId; tên/điện thoại/địa chỉ
                       do IOrderService đọc lại từ database rồi chụp vào đơn. *@
                    <input type="hidden" asp-for="UseNewAddress" id="useNewAddress" />
                    <span class="text-danger small d-block mb-2" asp-validation-for="SelectedAddressId"></span>

                    @if (Model.HasSavedAddresses)
                    {
                        <div class="address-current mb-3 @(Model.ShowNewAddressForm ? "d-none" : null)" id="addressCurrent">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                @* JS thay nội dung khối này khi khách chọn radio khác. *@
                                <div class="min-w-0" id="addressCurrentBody">
                                    @if (Model.SelectedAddress is { } selected)
                                    {
                                        <span class="fw-semibold">
                                            @selected.FullName
                                            <span class="text-secondary fw-normal">· @selected.PhoneNumber</span>
                                        </span>
                                        @if (selected.IsDefault)
                                        {
                                            <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle ms-1">Mặc định</span>
                                        }
                                        <span class="product-meta d-block">@selected.FullAddress</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">Chưa chọn địa chỉ giao hàng.</span>
                                    }
                                </div>
                                <button class="btn btn-outline-primary btn-sm flex-shrink-0" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#addressPicker"
                                        aria-expanded="@(Model.SelectedAddress is null ? "true" : "false")"
                                        aria-controls="addressPicker">
                                    Thay đổi địa chỉ
                                </button>
                            </div>
                        </div>

                        @* Mở sẵn khi chưa chọn được địa chỉ nào (ví dụ vừa bị lỗi validate). *@
                        <div class="collapse @(Model.SelectedAddress is null ? "show" : null) mb-3" id="addressPicker">
                            <div class="address-list" data-address-picker>
                                @foreach (var address in Model.SavedAddresses)
                                {
                                    var radioId = $"address-{address.Id}";
                                    <div class="form-check address-option">
                                        <input class="form-check-input" type="radio" asp-for="SelectedAddressId"
                                               id="@radioId" value="@address.Id" data-address-option />
                                        <label class="form-check-label" for="@radioId">
                                            <span class="fw-semibold">
                                                @address.FullName
                                                <span class="text-secondary fw-normal">· @address.PhoneNumber</span>
                                            </span>
                                            @if (address.IsDefault)
                                            {
                                                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle ms-1">Mặc định</span>
                                            }
                                            <span class="product-meta d-block">@address.FullAddress</span>
                                        </label>
                                    </div>
                                }
                            </div>

                            <button class="btn btn-outline-secondary btn-sm mt-3" type="button" data-address-new>
                                + Thêm địa chỉ mới
                            </button>
                        </div>
                    }

                    @* Form nhập tay: hiện khi sổ rỗng hoặc khách bấm "Thêm địa chỉ mới".
                       Khi bị ẩn, jQuery validate bỏ qua (ignore ":hidden") nên không chặn submit. *@
                    <div id="newAddressForm" class="@(Model.ShowNewAddressForm ? null : "d-none")">
                        @if (Model.HasSavedAddresses)
                        {
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                <span class="fw-semibold">Địa chỉ mới</span>
                                <button class="btn btn-link btn-sm p-0" type="button" data-address-cancel-new>
                                    Dùng địa chỉ đã lưu
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="product-meta mb-3">
                                Bạn chưa có địa chỉ nào trong sổ. Nhập địa chỉ nhận hàng bên dưới,
                                đơn hàng sẽ được giao tới đúng địa chỉ này.
                            </p>
                        }

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="FullName"></label>
                            <input class="form-control" asp-for="FullName" autocomplete="name" />
                            <span class="text-danger small" asp-validation-for="FullName"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="Phone"></label>
                            <input class="form-control" asp-for="Phone" type="tel" autocomplete="tel"
                                   placeholder="0912345678" />
                            <span class="text-danger small" asp-validation-for="Phone"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label" asp-for="AddressLine"></label>
                            <input class="form-control" asp-for="AddressLine" autocomplete="street-address"
                                   placeholder="Số nhà, tên đường" />
                            <span class="text-danger small" asp-validation-for="AddressLine"></span>
                        </div>

                        @* ADDR-02 — Tỉnh/Thành phố và Phường/Xã chọn từ danh sách, không gõ tay.
                           Cấp Quận/Huyện đã bỏ theo cơ cấu hành chính từ 01/07/2025. *@
                        @if (Model.SelectorsAvailable)
                        {
                            <div class="col-12 col-md-6">
                                <label class="form-label" asp-for="ProvinceCode"></label>
                                <select class="form-select" asp-for="ProvinceCode"
                                        data-address-select
                                        data-search-placeholder="Tìm tỉnh/thành phố...">
                                    <option value="">— Chọn tỉnh/thành phố —</option>
                                    @foreach (var province in Model.Provinces)
                                    {
                                        <option value="@province.Code">@province.Name</option>
                                    }
                                </select>
                                <span class="text-danger small" asp-validation-for="ProvinceCode"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" asp-for="WardCode"></label>
                                @* Danh sách render sẵn từ server theo tỉnh đang chọn, nên mở lại
                                   form sau khi validate lỗi vẫn đúng dù JavaScript chưa chạy. *@
                                <select class="form-select" asp-for="WardCode"
                                        data-address-select
                                        data-search-placeholder="Tìm phường/xã..."
                                        data-depends-on="ProvinceCode"
                                        data-wards-url="@(Url.Action("GetWards", "AdministrativeUnits") ?? "/api/dia-gioi/phuong-xa")"
                                        data-empty-option="— Chọn phường/xã —"
                                        data-placeholder-option="— Chọn tỉnh/thành phố trước —">
                                    <option value="">@(Model.Wards.Count > 0 ? "— Chọn phường/xã —" : "— Chọn tỉnh/thành phố trước —")</option>
                                    @foreach (var ward in Model.Wards)
                                    {
                                        <option value="@ward.Code">@ward.Name</option>
                                    }
                                </select>
                                <span class="text-danger small" asp-validation-for="WardCode"></span>
                            </div>
                        }
                        else
                        {
                            @* Dataset địa giới hành chính không nạp được — cho nhập tay để khách
                               vẫn đặt được hàng, thay vì chặn cả luồng thanh toán. *@
                            <div class="col-12">
                                <div class="alert alert-warning mb-0">
                                    Hiện chưa tải được danh sách tỉnh/thành và phường/xã.
                                    Bạn vui lòng nhập tay hai ô bên dưới.
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" asp-for="Province"></label>
                                <input class="form-control" asp-for="Province" autocomplete="address-level1" />
                                <span class="text-danger small" asp-validation-for="Province"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" asp-for="Ward"></label>
                                <input class="form-control" asp-for="Ward" autocomplete="address-level2" />
                                <span class="text-danger small" asp-validation-for="Ward"></span>
                            </div>
                        }

                    </div>
                    </div>@* /#newAddressForm *@

                    <div class="mt-3">
                        <label class="form-label" asp-for="Note"></label>
                        <textarea class="form-control" asp-for="Note" rows="2"
                                  placeholder="Ví dụ: giao giờ hành chính"></textarea>
                        <span class="text-danger small" asp-validation-for="Note"></span>
                    </div>

                    <p class="product-meta mt-3 mb-0">
                        Hình thức thanh toán: thanh toán khi nhận hàng (COD).
                        Thanh toán online sẽ được bổ sung sau.
                    </p>
                </div>
            </div>

            <!-- Đơn hàng -->
            <div class="col-12 col-lg-5">
                <div class="panel cart-summary">
                    <h2 class="h6 fw-bold mb-3">Đơn hàng của bạn</h2>

                    <ul class="list-unstyled checkout-items mb-3">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <li class="d-flex gap-2 align-items-start py-2 border-bottom">
                                <img class="checkout-thumb"
                                     src="@DisplayHelper.ImageOrPlaceholder(item.ImageUrl)"
                                     alt="@item.Name" loading="lazy" />
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@item.Name</div>
                                    <div class="product-meta">@item.UnitPrice.ToVnd() × @item.Quantity</div>
                                </div>
                                <div class="text-end text-nowrap fw-semibold small">@item.LineTotal.ToVnd()</div>
                            </li>
                        }
                    </ul>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Tạm tính</span>
                        <span>@Model.SubTotal.ToVnd()</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Phí vận chuyển</span>
                        @if (Model.ShippingFee <= 0)
                        {
                            <span class="text-success">Miễn phí</span>
                        }
                        else
                        {
                            <span>@Model.ShippingFee.ToVnd()</span>
                        }
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-bold">Tổng cộng</span>
                        <span class="detail-price">@Model.Total.ToVnd()</span>
                    </div>

                    <button type="submit" class="btn btn-accent w-100 btn-lg" data-busy-text="Đang đặt hàng...">Đặt hàng</button>

                    <a class="btn btn-outline-secondary w-100 mt-2"
                       asp-area="" asp-controller="Cart" asp-action="Index">Quay lại giỏ hàng</a>

                    <p class="product-meta mt-3 mb-0">
                        Số tiền trên được hệ thống tính lại từ giá trong kho khi bấm "Đặt hàng",
                        nên luôn khớp với đơn hàng được tạo.
                    </p>
                </div>
            </div>

        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.SelectorsAvailable)
    {
        <script src="~/js/address-select.js" asp-append-version="true"></script>
    }
}
