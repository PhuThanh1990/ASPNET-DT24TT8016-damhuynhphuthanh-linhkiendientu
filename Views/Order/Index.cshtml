@model CustomerOrderListViewModel
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đơn hàng của tôi</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="section-title">Đơn hàng của tôi</h1>
        @if (Model.TotalItems > 0)
        {
            <span class="text-muted small">@Model.TotalItems đơn hàng</span>
        }
    </div>

    @if (Model.IsEmpty)
    {
        <div class="empty-state">
            <div class="empty-icon">🧾</div>
            <h2 class="h5 text-body">Bạn chưa có đơn hàng nào</h2>
            <p class="mb-3">Các đơn hàng bạn đặt sẽ được lưu lại ở đây.</p>
            <a class="btn btn-primary" asp-area="" asp-controller="Product" asp-action="Index">Bắt đầu mua sắm</a>
        </div>
    }
    else
    {
        <div class="bg-white border rounded-3 p-2 p-md-3">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr class="small text-muted">
                            <th scope="col">Mã đơn</th>
                            <th scope="col" class="d-none d-md-table-cell">Ngày đặt</th>
                            <th scope="col" class="d-none d-sm-table-cell text-center">Số sản phẩm</th>
                            <th scope="col" class="text-end">Tổng tiền</th>
                            <th scope="col" class="text-center">Trạng thái</th>
                            <th scope="col"><span class="visually-hidden">Chi tiết</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td>
                                    <a class="fw-semibold text-decoration-none"
                                       asp-area="" asp-controller="Order" asp-action="Details" asp-route-id="@order.Id">
                                        @order.OrderCode
                                    </a>
                                    <div class="product-meta d-md-none">
                                        @order.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell text-nowrap">
                                    @order.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")
                                </td>
                                <td class="d-none d-sm-table-cell text-center">@order.ItemCount</td>
                                <td class="text-end fw-semibold text-nowrap">@order.TotalAmount.ToVnd()</td>
                                <td class="text-center">
                                    <span class="badge @order.StatusBadgeClass">@order.StatusText</span>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-area="" asp-controller="Order" asp-action="Details" asp-route-id="@order.Id">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Phân trang đơn hàng" class="mt-4">
                <ul class="pagination justify-content-center flex-wrap mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? null : "disabled")">
                        <a class="page-link" asp-area="" asp-controller="Order" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)" aria-label="Trang trước">&laquo;</a>
                    </li>

                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : null)">
                            <a class="page-link" asp-area="" asp-controller="Order" asp-action="Index"
                               asp-route-page="@pageNumber">@pageNumber</a>
                        </li>
                    }

                    <li class="page-item @(Model.HasNextPage ? null : "disabled")">
                        <a class="page-link" asp-area="" asp-controller="Order" asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)" aria-label="Trang sau">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    }

</div>
