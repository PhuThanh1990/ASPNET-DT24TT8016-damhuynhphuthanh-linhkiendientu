@model AddressFormViewModel
@{
    ViewData["Title"] = "Sửa địa chỉ";
}

<div class="container">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Sổ địa chỉ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Sửa địa chỉ</li>
        </ol>
    </nav>

    <div class="section-head">
        <div>
            <h1 class="section-title">Sửa địa chỉ</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8">
            <div class="panel">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <partial name="_Form" model="Model" />

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.SelectorsAvailable)
    {
        @* Dùng lại đúng bộ selectbox của trang thanh toán (ADDR-02), không có hệ thống thứ hai. *@
        <script src="~/js/address-select.js" asp-append-version="true"></script>
    }
}
