@model ProductDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    var mainImageUrl = DisplayHelper.ImageOrPlaceholder(Model.PrimaryImage?.ImageUrl);
    var mainImageAlt = string.IsNullOrWhiteSpace(Model.PrimaryImage?.AltText) ? Model.Name : Model.PrimaryImage!.AltText;
}

<div class="container">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
            @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Product" asp-action="Index" asp-route-category="@Model.CategorySlug">@Model.CategoryName</a>
                </li>
            }
            <li class="breadcrumb-item active text-truncate" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="panel mb-4">
        <div class="row g-4 g-lg-5">

            @* ── Gallery (5/12) ──────────────────────────────────────────────── *@
            <div class="col-12 col-lg-5">
                <img id="detailMainImage" class="detail-main-image" src="@mainImageUrl" alt="@mainImageAlt" />

                @if (Model.Images.Count > 1)
                {
                    <div class="detail-thumbs mt-3">
                        @for (var i = 0; i < Model.Images.Count; i++)
                        {
                            var image = Model.Images[i];
                            <img class="detail-thumb @(i == 0 ? "active" : null)"
                                 src="@image.ImageUrl"
                                 alt="@(string.IsNullOrWhiteSpace(image.AltText) ? Model.Name : image.AltText)"
                                 data-full="@image.ImageUrl"
                                 loading="lazy" />
                        }
                    </div>
                }
                else if (Model.Images.Count == 0)
                {
                    <p class="product-meta text-center mt-2 mb-0">Sản phẩm chưa có ảnh</p>
                }
            </div>

            @* ── Thông tin (7/12). Thứ tự theo design-system § 8:
                  tên → brand/danh mục → giá → tồn kho → số lượng → CTA. ────────── *@
            <div class="col-12 col-lg-7">
                <h1 class="detail-title mb-2">@Model.Name</h1>

                <div class="product-meta mb-3">
                    <span>Mã SP: <span class="fw-semibold">@Model.Sku</span></span>
                    @if (!string.IsNullOrWhiteSpace(Model.BrandName))
                    {
                        <span class="ms-3">
                            Thương hiệu:
                            <a class="fw-semibold" asp-controller="Product" asp-action="Index" asp-route-brand="@Model.BrandSlug">@Model.BrandName</a>
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                    {
                        <span class="ms-3">
                            Danh mục:
                            <a class="fw-semibold" asp-controller="Product" asp-action="Index" asp-route-category="@Model.CategorySlug">@Model.CategoryName</a>
                        </span>
                    }
                </div>

                <div class="detail-price-box mb-3">
                    <span class="detail-price">@Model.Price.ToVnd()</span>
                    @if (Model.HasDiscount)
                    {
                        <span class="product-old-price ms-2">@Model.OldPrice.ToVnd()</span>
                        <span class="badge text-bg-danger ms-2">-@Model.DiscountPercent%</span>
                    }
                </div>

                <div class="mb-3">
                    @if (Model.InStock)
                    {
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                            Còn hàng &middot; @Model.StockQuantity sản phẩm
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">
                            Tạm hết hàng
                        </span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                {
                    <p class="text-secondary">@Model.ShortDescription</p>
                }

                @* CUS-12 — chỉ productId và quantity được gửi lên, giá do server tự đọc lại. *@
                <form class="detail-buy mt-4" asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="d-flex flex-wrap align-items-end gap-3">
                        <div>
                            <label class="form-label" for="quantity">Số lượng</label>
                            @* Nút −/+ chỉ chỉnh giá trị ô input ở client; số lượng thật vẫn do
                               ô number gửi lên, nên tắt JavaScript vẫn đặt hàng được. *@
                            <div class="qty-stepper" data-qty-stepper>
                                <button class="btn btn-outline-secondary" type="button" data-qty-step="-1"
                                        aria-label="Giảm số lượng" disabled="@(!Model.InStock)">&minus;</button>
                                <input class="form-control cart-qty" id="quantity" type="number" name="quantity"
                                       value="1" min="1" max="@Model.StockQuantity"
                                       disabled="@(!Model.InStock)" />
                                <button class="btn btn-outline-secondary" type="button" data-qty-step="1"
                                        aria-label="Tăng số lượng" disabled="@(!Model.InStock)">+</button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-accent btn-lg flex-grow-1" disabled="@(!Model.InStock)">
                            Thêm vào giỏ hàng
                        </button>
                    </div>
                </form>

                <p class="product-meta mt-3 mb-0">
                    @if (Model.InStock)
                    {
                        @:Thanh toán khi nhận hàng (COD). Giá và tồn kho được kiểm tra lại khi đặt hàng.
                    }
                    else
                    {
                        @:Sản phẩm đang hết hàng nên chưa thể thêm vào giỏ.
                    }
                </p>
            </div>
        </div>
    </div>

    @* Trên mobile thông số lên trước mô tả (ưu tiên thông tin theo § 8);
       desktop giữ bố cục mô tả trái / thông số phải như sơ đồ. *@
    <div class="row g-4">
        <div class="col-12 col-lg-7 order-2 order-lg-1">
            <section class="panel h-100">
                <h2 class="section-title mb-3">Mô tả sản phẩm</h2>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    @* Description do admin nhập, cho phép chứa HTML (xem docs/database-schema.md § 6). *@
                    <div class="product-description">@Html.Raw(Model.Description)</div>
                }
                else if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                {
                    <p class="mb-0">@Model.ShortDescription</p>
                }
                else
                {
                    <p class="text-secondary mb-0">Sản phẩm này chưa có mô tả chi tiết.</p>
                }
            </section>
        </div>

        <div class="col-12 col-lg-5 order-1 order-lg-2">
            <section class="panel h-100">
                <h2 class="section-title mb-3">Thông số kỹ thuật</h2>
                @* Specifications là JSON trong DB; SpecificationParser đã lọc sẵn nên
                   dữ liệu hỏng/thiếu chỉ cho ra danh sách rỗng chứ không làm vỡ trang. *@
                @if (Model.Specifications.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table spec-table mb-0">
                            <tbody>
                                @foreach (var specification in Model.Specifications)
                                {
                                    <tr>
                                        <th scope="row">@specification.Name</th>
                                        <td>@specification.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-secondary mb-0">Sản phẩm này chưa có thông số kỹ thuật.</p>
                }
            </section>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Đổi ảnh lớn khi bấm vào ảnh nhỏ trong gallery.
        document.querySelectorAll('.detail-thumb').forEach(function (thumb) {
            thumb.addEventListener('click', function () {
                var main = document.getElementById('detailMainImage');
                if (!main) { return; }

                main.src = thumb.dataset.full;
                main.alt = thumb.alt;

                document.querySelectorAll('.detail-thumb').forEach(function (other) {
                    other.classList.remove('active');
                });
                thumb.classList.add('active');
            });
        });
    </script>
}
