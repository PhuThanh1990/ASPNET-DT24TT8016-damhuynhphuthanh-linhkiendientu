@{
    // Dùng để tô sáng menu đang mở.
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHome = currentController == "Home" && currentAction == "Index";
    var isProduct = currentController == "Product";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ElectronicStore</title>
    <meta name="description" content="ElectronicStore - cửa hàng linh kiện điện tử: CPU, RAM, VGA, mainboard, ổ cứng, nguồn máy tính." />
    <script type="importmap"></script>
    @* CSS layering (UI-01). Load order matters: every later file may override the earlier ones.
       1. UI foundation - Tabler. Tabler ships a complete Bootstrap 5 build themed with its own
          --tblr-* variables, so bootstrap.css must NOT be loaded as well; doing so would send
          Bootstrap down the wire twice. Every Bootstrap class (grid, navbar, modal, utilities)
          is still available from this single file.
       2. Icon set - Tabler Icons, the one icon library of this project.
       3. Shared tweaks, 4. customer design system, 5. per-view scoped CSS. *@
    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="~/lib/tabler-icons/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ElectronicStore.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Thanh thông tin trên cùng: ẩn trên màn hình nhỏ cho gọn -->
        <div class="shop-topbar d-none d-lg-block">
            <div class="container d-flex justify-content-between py-1">
                <span>Hotline: <a href="tel:19001234">1900 1234</a> &nbsp;|&nbsp; Email: <a href="mailto:hotro@electronicstore.vn">hotro@electronicstore.vn</a></span>
                <span>Giao hàng toàn quốc &nbsp;|&nbsp; Bảo hành chính hãng</span>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg shop-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Electronic<span>Store</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-lg-3">
                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : null)" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isProduct ? "active" : null)" asp-controller="Product" asp-action="Index">Sản phẩm</a>
                        </li>
                        @* Danh mục lấy từ database; không có danh mục nào thì không hiện menu này *@
                        @await Component.InvokeAsync("CategoryMenu")
                    </ul>

                    <!-- CUS-08: tìm theo tên sản phẩm, mã SKU hoặc thương hiệu -->
                    <form class="d-flex shop-search my-2 my-lg-0 me-lg-auto" role="search"
                          asp-controller="Product" asp-action="Index" method="get">
                        <input class="form-control" type="search" name="keyword" maxlength="100"
                               placeholder="Tìm CPU, RAM, VGA, SSD..." aria-label="Tìm sản phẩm" />
                        <button class="btn btn-accent ms-2 flex-shrink-0" type="submit" aria-label="Tìm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85zm-5.242 1.156a5 5 0 1 1 0-10 5 5 0 0 1 0 10z" />
                            </svg>
                        </button>
                    </form>

                    <ul class="navbar-nav align-items-lg-center">
                        @* CUS-12: số lượng lấy từ giỏ hàng trong Session *@
                        @await Component.InvokeAsync("CartSummary")
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <partial name="_StatusMessage" />

    <main role="main" class="shop-main py-4">
        @RenderBody()
    </main>

    <footer class="shop-footer pt-4 mt-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-12 col-md-6 col-lg-4">
                    <h6 class="text-uppercase">ElectronicStore</h6>
                    <p class="mb-2 small">
                        Cửa hàng linh kiện điện tử: CPU, mainboard, RAM, VGA, ổ cứng, nguồn và phụ kiện máy tính.
                        Hàng chính hãng, bảo hành đầy đủ.
                    </p>
                    <p class="small mb-0">Đồ án môn ASP.NET Core MVC.</p>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="text-uppercase">Liên kết</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="mb-1"><a asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
                        <li class="mb-1"><a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-3">
                    <h6 class="text-uppercase">Hỗ trợ</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1">Hướng dẫn mua hàng</li>
                        <li class="mb-1">Chính sách bảo hành</li>
                        <li class="mb-1">Chính sách đổi trả</li>
                        <li class="mb-1">Vận chuyển &amp; thanh toán</li>
                    </ul>
                </div>

                <div class="col-12 col-lg-3">
                    <h6 class="text-uppercase">Liên hệ</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1">123 Nguyễn Văn Cừ, Quận 5, TP. Hồ Chí Minh</li>
                        <li class="mb-1">Hotline: <a href="tel:19001234">1900 1234</a></li>
                        <li class="mb-1">Email: <a href="mailto:hotro@electronicstore.vn">hotro@electronicstore.vn</a></li>
                        <li class="mb-1">Giờ mở cửa: 8:00 - 21:00 (T2 - CN)</li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom d-flex flex-column flex-sm-row justify-content-between align-items-center gap-1 mt-4 py-3">
                <span>&copy; @DateTime.Now.Year ElectronicStore. Đồ án sinh viên.</span>
                <span>Thông tin liên hệ ở trên chỉ là dữ liệu mẫu.</span>
            </div>
        </div>
    </footer>

    @* JS layering (UI-01):
       1. jQuery - only still here because jquery-validation-unobtrusive needs it.
       2. Tabler - bundles Bootstrap's JS plus Popper, so bootstrap.bundle.js must NOT be
          loaded as well; two copies would register the data-bs-* handlers twice and every
          dropdown/collapse/modal would toggle twice per click.
       3. Site script, then per-view sections. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/tabler/dist/js/tabler.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
