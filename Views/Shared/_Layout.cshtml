@{
    // Dùng để tô sáng mục đang mở trên thanh điều hướng.
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHome = currentController == "Home" && currentAction == "Index";
    var isProduct = currentController == "Product";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ElectronicStore</title>
    <meta name="description" content="ElectronicStore - cửa hàng linh kiện điện tử: CPU, RAM, VGA, mainboard, ổ cứng, nguồn máy tính." />
    <script type="importmap"></script>
    @* CSS layering (UI-01). Load order matters: every later file may override the earlier ones.
       1. UI foundation - Tabler. Tabler ships a complete Bootstrap 5 build themed with its own
          --tblr-* variables, so bootstrap.css must NOT be loaded as well; doing so would send
          Bootstrap down the wire twice. Every Bootstrap class (grid, navbar, modal, utilities)
          is still available from this single file.
       2. Icon set - Tabler Icons, the one icon library of this project.
       3. Shared tweaks, 4. customer design system, 5. per-view scoped CSS. *@
    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="~/lib/tabler-icons/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* UI-00 design system: tokens phải nạp trước, component nạp sau. *@
    <link rel="stylesheet" href="~/css/customer-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ElectronicStore.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main-content">Bỏ qua, tới nội dung chính</a>

    <header class="customer-header">
        @* Thanh thông tin: ẩn dưới lg cho gọn, nội dung không thiết yếu. *@
        <div class="customer-header__top d-none d-lg-block">
            <div class="container customer-header__top-inner">
                <div class="d-flex flex-wrap gap-4">
                    <span class="customer-header__note">
                        <i class="ti ti-phone" aria-hidden="true"></i>
                        Hotline: <a href="tel:19001234">1900 1234</a>
                    </span>
                    <span class="customer-header__note">
                        <i class="ti ti-mail" aria-hidden="true"></i>
                        <a href="mailto:hotro@electronicstore.vn">hotro@electronicstore.vn</a>
                    </span>
                </div>
                <div class="d-flex flex-wrap gap-4">
                    <span class="customer-header__note">
                        <i class="ti ti-truck" aria-hidden="true"></i> Giao hàng toàn quốc
                    </span>
                    <span class="customer-header__note">
                        <i class="ti ti-shield-check" aria-hidden="true"></i> Bảo hành chính hãng
                    </span>
                </div>
            </div>
        </div>

        <div class="customer-header__main">
            <div class="container customer-header__inner">

                <button class="customer-header__toggle d-lg-none" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#customerMenu"
                        aria-controls="customerMenu" aria-label="Mở menu danh mục">
                    <i class="ti ti-menu-2" aria-hidden="true"></i>
                </button>

                <a class="customer-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="customer-brand__mark" aria-hidden="true"><i class="ti ti-cpu"></i></span>
                    <span class="customer-brand__text">Electronic<span>Store</span></span>
                </a>

                @* CUS-08: tìm theo tên sản phẩm, mã SKU hoặc thương hiệu.
                   Chỉ một form duy nhất trong DOM — mobile/desktop khác nhau ở thứ tự flex. *@
                <form class="customer-search" role="search"
                      asp-area="" asp-controller="Product" asp-action="Index" method="get">
                    <label class="visually-hidden" for="headerSearch">Tìm sản phẩm</label>
                    <i class="ti ti-search customer-search__icon" aria-hidden="true"></i>
                    <input class="customer-search__input" id="headerSearch" type="search" name="keyword"
                           maxlength="100" placeholder="Tìm CPU, RAM, VGA, SSD..." />
                    <button class="customer-search__submit" type="submit">Tìm</button>
                </form>

                <div class="customer-actions">
                    <partial name="_LoginPartial" />
                    @* CUS-12: số lượng lấy từ giỏ hàng trong Session *@
                    @await Component.InvokeAsync("CartSummary")
                </div>
            </div>
        </div>

        @* Hàng danh mục: chỉ desktop. Trên mobile danh mục nằm trong offcanvas để
           không phải cuộn ngang một hàng dài. *@
        <nav class="customer-nav d-none d-lg-block" aria-label="Danh mục sản phẩm">
            <div class="container">
                <ul class="customer-nav__list">
                    <li>
                        <a class="customer-nav__link @(isHome ? "is-active" : null)"
                           asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li>
                        <a class="customer-nav__link @(isProduct ? "is-active" : null)"
                           asp-area="" asp-controller="Product" asp-action="Index">Tất cả sản phẩm</a>
                    </li>
                    @* Danh mục lấy từ database; không có danh mục nào thì không hiện gì thêm. *@
                    @await Component.InvokeAsync("CategoryMenu")
                </ul>
            </div>
        </nav>
    </header>

    <div class="offcanvas offcanvas-start customer-offcanvas" tabindex="-1" id="customerMenu"
         aria-labelledby="customerMenuLabel">
        <div class="offcanvas-header border-bottom">
            <h2 class="offcanvas-title h6 mb-0" id="customerMenuLabel">Danh mục sản phẩm</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Đóng menu"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="customer-menu">
                <li>
                    <a class="customer-menu__link @(isHome ? "is-active" : null)"
                       asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                </li>
                <li>
                    <a class="customer-menu__link @(isProduct ? "is-active" : null)"
                       asp-area="" asp-controller="Product" asp-action="Index">Tất cả sản phẩm</a>
                </li>
                <li>
                    <a class="customer-menu__link" asp-area="" asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
                </li>
            </ul>

            @await Component.InvokeAsync("CategoryMenu", new { variant = "offcanvas" })
        </div>
    </div>

    <partial name="_StatusMessage" />

    <main role="main" id="main-content" class="shop-main">
        @RenderBody()
    </main>

    <footer class="shop-footer">
        <div class="container">
            <div class="row g-4 g-lg-5">
                <div class="col-12 col-lg-4">
                    <a class="shop-footer__brand mb-3" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="ti ti-cpu" aria-hidden="true"></i>
                        <span>Electronic<span class="shop-footer__brand-accent">Store</span></span>
                    </a>
                    <p class="shop-footer__about mb-0">
                        Cửa hàng linh kiện điện tử: vi điều khiển, cảm biến, module, nguồn và phụ kiện.
                        Đồ án môn ASP.NET Core MVC.
                    </p>
                </div>

                <div class="col-6 col-lg-2">
                    <h2>Điều hướng</h2>
                    <ul class="shop-footer__list">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a asp-area="" asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
                        <li><a asp-area="" asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
                        <li><a asp-area="" asp-controller="Order" asp-action="Index">Đơn hàng của tôi</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <h2>Hỗ trợ</h2>
                    <ul class="shop-footer__list shop-footer__plain">
                        <li>Hướng dẫn mua hàng</li>
                        <li>Chính sách bảo hành</li>
                        <li>Chính sách đổi trả</li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                    </ul>
                </div>

                <div class="col-12 col-lg-3">
                    <h2>Liên hệ</h2>
                    <ul class="shop-footer__list shop-footer__contact">
                        <li>
                            <i class="ti ti-phone" aria-hidden="true"></i>
                            <a href="tel:19001234">1900 1234</a>
                        </li>
                        <li>
                            <i class="ti ti-mail" aria-hidden="true"></i>
                            <a href="mailto:hotro@electronicstore.vn">hotro@electronicstore.vn</a>
                        </li>
                        <li>
                            <i class="ti ti-clock" aria-hidden="true"></i>
                            <span class="shop-footer__plain">8:00 - 21:00 (T2 - CN)</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <span>&copy; @DateTime.Now.Year ElectronicStore. Đồ án sinh viên.</span>
                <span>Thông tin liên hệ chỉ là dữ liệu mẫu.</span>
            </div>
        </div>
    </footer>

    @* JS layering (UI-01):
       1. jQuery - only still here because jquery-validation-unobtrusive needs it.
       2. Tabler - bundles Bootstrap's JS plus Popper, so bootstrap.bundle.js must NOT be
          loaded as well; two copies would register the data-bs-* handlers twice and every
          dropdown/collapse/modal would toggle twice per click.
       3. Site script, then per-view sections. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/tabler/dist/js/tabler.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
