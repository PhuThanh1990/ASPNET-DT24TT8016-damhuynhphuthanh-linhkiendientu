@model ProductCardViewModel
@*
    CUS-04 — Card sản phẩm dùng lại được.
    Gọi ở view khác bằng: <partial name="_ProductCard" model="item" />
    Đã xử lý sẵn: không có ảnh, thiếu brand/category, hết hàng.
    Nút "Thêm vào giỏ" thuộc task Cart nên chưa có ở đây.
*@
<div class="card product-card">
    <a class="product-thumb-link" asp-controller="Product" asp-action="Details" asp-route-slug="@Model.Slug">
        <img class="product-thumb"
             src="@DisplayHelper.ImageOrPlaceholder(Model.ImageUrl)"
             alt="@(string.IsNullOrWhiteSpace(Model.ImageAltText) ? Model.Name : Model.ImageAltText)"
             loading="lazy" />

        @if (Model.HasDiscount)
        {
            <span class="badge bg-danger product-badge-discount">-@Model.DiscountPercent%</span>
        }
    </a>

    <div class="card-body d-flex flex-column p-3">
        @if (!string.IsNullOrWhiteSpace(Model.BrandName) || !string.IsNullOrWhiteSpace(Model.CategoryName))
        {
            <div class="product-meta text-truncate mb-1">
                @if (!string.IsNullOrWhiteSpace(Model.BrandName))
                {
                    <span class="fw-semibold">@Model.BrandName</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.BrandName) && !string.IsNullOrWhiteSpace(Model.CategoryName))
                {
                    <span>&middot;</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                {
                    <span>@Model.CategoryName</span>
                }
            </div>
        }

        <h3 class="product-name mb-2">
            <a asp-controller="Product" asp-action="Details" asp-route-slug="@Model.Slug">@Model.Name</a>
        </h3>

        <div class="mb-2">
            <span class="product-price">@Model.Price.ToVnd()</span>
            @if (Model.HasDiscount)
            {
                <span class="product-old-price ms-1">@Model.OldPrice.ToVnd()</span>
            }
        </div>

        <div class="mb-3">
            @if (Model.InStock)
            {
                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                    Còn hàng (@Model.StockQuantity)
                </span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">
                    Hết hàng
                </span>
            }
        </div>

        <a class="btn btn-outline-primary btn-sm mt-auto w-100"
           asp-controller="Product" asp-action="Details" asp-route-slug="@Model.Slug">
            Xem chi tiết
        </a>
    </div>
</div>
