@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

@* Trang này chạy qua UseExceptionHandler("/Home/Error") ở môi trường ngoài Development.
   Chỉ hiển thị lời xin lỗi và mã yêu cầu để đối chiếu với log — không bao giờ in thông
   điệp exception hay stack trace ra cho khách. Ở Development, DeveloperExceptionPage của
   ASP.NET Core vẫn hiện chi tiết đầy đủ như bình thường. *@
<div class="container">
    <div class="empty-state my-5">
        <div class="empty-icon">⚠️</div>
        <h1 class="h3 text-body mb-2">Đã xảy ra lỗi</h1>
        <p class="mb-4">
            Rất tiếc, hệ thống gặp sự cố khi xử lý yêu cầu của bạn.
            Vui lòng thử lại sau ít phút.
        </p>

        @if (Model?.ShowRequestId == true)
        {
            <p class="text-muted small mb-4">
                Mã yêu cầu: <code>@Model.RequestId</code>
                <br />
                Vui lòng gửi mã này cho bộ phận hỗ trợ để được kiểm tra nhanh hơn.
            </p>
        }

        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
            <a class="btn btn-outline-secondary" asp-controller="Product" asp-action="Index">Xem sản phẩm</a>
        </div>
    </div>
</div>
