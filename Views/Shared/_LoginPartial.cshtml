@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@*
    UI-02 — mục tài khoản trên header. Luôn là một nút icon + dropdown để giữ nguyên
    một cách thao tác ở mọi kích thước màn hình (nhãn chữ tự ẩn dưới 768px).
    Đăng xuất vẫn là form POST có antiforgery như thiết kế ban đầu.
*@
@{
    var signedIn = SignInManager.IsSignedIn(User);
    var displayName = signedIn ? UserManager.GetUserName(User) : null;
}

<div class="dropdown">
    <button class="header-action dropdown-toggle" type="button" data-bs-toggle="dropdown"
            aria-expanded="false" aria-label="@(signedIn ? "Tài khoản của " + displayName : "Tài khoản")">
        <i class="ti ti-user header-action__icon" aria-hidden="true"></i>
        <span class="header-action__label">@(signedIn ? "Tài khoản" : "Đăng nhập")</span>
    </button>

    <ul class="dropdown-menu dropdown-menu-end account-menu">
        @if (signedIn)
        {
            <li class="account-menu__name">
                Đang đăng nhập
                <strong>@displayName</strong>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <a class="dropdown-item" asp-area="" asp-controller="Order" asp-action="Index">
                    <i class="ti ti-package" aria-hidden="true"></i> Đơn hàng của tôi
                </a>
            </li>
            <li>
                <a class="dropdown-item" asp-area="" asp-controller="Cart" asp-action="Index">
                    <i class="ti ti-shopping-cart" aria-hidden="true"></i> Giỏ hàng
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item">
                        <i class="ti ti-logout" aria-hidden="true"></i> Đăng xuất
                    </button>
                </form>
            </li>
        }
        else
        {
            <li>
                <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Login">
                    <i class="ti ti-user" aria-hidden="true"></i> Đăng nhập
                </a>
            </li>
            <li>
                <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Register">
                    <i class="ti ti-user-circle" aria-hidden="true"></i> Đăng ký
                </a>
            </li>
        }
    </ul>
</div>
