@{
    // Thông báo một lần sau khi POST (thêm/sửa/xóa giỏ hàng, đặt/hủy đơn) rồi redirect.
    var message = TempData["StatusMessage"] as string;
    var messageType = TempData["StatusMessageType"] as string ?? "info";

    // Chỉ cho phép các kiểu alert đã biết, để giá trị lạ không chèn được class linh tinh.
    string[] allowedTypes = ["success", "warning", "danger", "info"];
    if (!allowedTypes.Contains(messageType))
    {
        messageType = "info";
    }

    // Biểu tượng theo ngữ nghĩa, dùng ký tự nên không phụ thuộc icon font nào.
    var icon = messageType switch
    {
        "success" => "✓",
        "warning" => "!",
        "danger" => "×",
        _ => "i",
    };
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="container mt-3">
        <div class="alert alert-@messageType alert-dismissible fade show mb-0" role="alert">
            <div class="d-flex align-items-start gap-2">
                <span class="status-icon" aria-hidden="true">@icon</span>
                <div>@message</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    </div>
}
