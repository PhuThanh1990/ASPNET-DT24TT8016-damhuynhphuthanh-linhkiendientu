@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container">

    @* ── Hero: ít chữ, một CTA rõ (design-system § 1). ───────────────────────── *@
    <section class="shop-hero p-4 p-lg-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge hero-badge mb-3">Linh kiện chính hãng &middot; Bảo hành đầy đủ</span>
                <h1 class="mb-3">Xây dựng cấu hình máy tính của bạn</h1>
                <p class="mb-4">
                    CPU, mainboard, RAM, VGA, ổ cứng SSD, nguồn và tản nhiệt — đầy đủ linh kiện
                    cho một dàn máy chơi game, làm đồ họa hay học tập.
                </p>
                <a class="btn btn-accent btn-lg" asp-controller="Product" asp-action="Index">
                    Xem tất cả sản phẩm
                </a>
            </div>
            <div class="col-lg-5">
                <div class="row g-2 g-sm-3 text-center">
                    <div class="col-4">
                        <div class="shop-hero-stat p-3 h-100">
                            <div class="fw-bold fs-5">100%</div>
                            <div class="small opacity-75">Chính hãng</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="shop-hero-stat p-3 h-100">
                            <div class="fw-bold fs-5">36</div>
                            <div class="small opacity-75">Tháng bảo hành</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="shop-hero-stat p-3 h-100">
                            <div class="fw-bold fs-5">24h</div>
                            <div class="small opacity-75">Giao nhanh</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ── Danh mục ────────────────────────────────────────────────────────────── *@
    <section class="section">
        <div class="section-head">
            <div>
                <h2 class="section-title">Danh mục nổi bật</h2>
                <p class="section-subtitle">Chọn nhóm linh kiện bạn đang cần</p>
            </div>
            @if (Model.Categories.Count > 0)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-controller="Product" asp-action="Index">
                    Xem tất cả
                </a>
            }
        </div>

        @if (Model.Categories.Count > 0)
        {
            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 g-lg-4">
                @foreach (var category in Model.Categories)
                {
                    <div class="col">
                        <a class="category-card" asp-controller="Product" asp-action="Index" asp-route-category="@category.Slug">
                            @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                            {
                                <img class="category-thumb" src="@category.ImageUrl" alt="@category.Name" loading="lazy" />
                            }
                            else
                            {
                                <div class="category-initial">@category.Name.Substring(0, 1).ToUpper()</div>
                            }
                            <div class="fw-semibold">@category.Name</div>
                            <div class="product-meta">@category.ProductCount sản phẩm</div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📂</div>
                <h3 class="h5 text-body">Chưa có danh mục nào</h3>
                <p class="mb-0">Danh mục sẽ hiện ở đây sau khi được thêm vào hệ thống.</p>
            </div>
        }
    </section>

    @* ── Sản phẩm nổi bật ────────────────────────────────────────────────────── *@
    @if (Model.FeaturedProducts.Count > 0)
    {
        <section class="section">
            <div class="section-head">
                <div>
                    <h2 class="section-title">Sản phẩm nổi bật</h2>
                    <p class="section-subtitle">Linh kiện được cửa hàng chọn lọc</p>
                </div>
                <a class="btn btn-outline-secondary btn-sm" asp-controller="Product" asp-action="Index">Xem tất cả</a>
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 g-lg-4">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <div class="col">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            </div>
        </section>
    }

    @* ── Sản phẩm mới ────────────────────────────────────────────────────────── *@
    @if (Model.LatestProducts.Count > 0)
    {
        <section class="section">
            <div class="section-head">
                <div>
                    <h2 class="section-title">Sản phẩm mới nhất</h2>
                    <p class="section-subtitle">Hàng vừa được bổ sung vào kho</p>
                </div>
                <a class="btn btn-outline-secondary btn-sm" asp-controller="Product" asp-action="Index">Xem tất cả</a>
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 g-lg-4">
                @foreach (var product in Model.LatestProducts)
                {
                    <div class="col">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            </div>
        </section>
    }

    @* Database chưa có sản phẩm nào — không dựng section rỗng. *@
    @if (!Model.HasAnyProduct)
    {
        <section class="section">
            <div class="empty-state">
                <div class="empty-icon">🛠️</div>
                <h2 class="h5 text-body">Cửa hàng chưa có sản phẩm</h2>
                <p class="mb-0">Dữ liệu sản phẩm sẽ hiển thị ngay khi được thêm vào database.</p>
            </div>
        </section>
    }
    else
    {
        <section class="section">
            <div class="home-cta text-center">
                <h2 class="h5 fw-bold mb-2">Chưa tìm được linh kiện phù hợp?</h2>
                <p class="text-secondary mb-3">Xem toàn bộ danh sách linh kiện đang có tại cửa hàng.</p>
                <a class="btn btn-primary" asp-controller="Product" asp-action="Index">Xem tất cả sản phẩm</a>
            </div>
        </section>
    }

</div>
