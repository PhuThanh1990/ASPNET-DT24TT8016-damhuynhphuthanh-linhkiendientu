@model OrderDetailViewModel
@{
    ViewData["Title"] = $"Đơn {Model.OrderCode}";
    ViewData["Subtitle"] = $"Đặt lúc {Model.CreatedAt.ToLocalTime():HH:mm dd/MM/yyyy}";
}

@section PageActions {
    <a class="btn" asp-area="Admin" asp-controller="Order" asp-action="Index"><i class="ti ti-arrow-left me-1"></i>Quay lại danh sách</a>
}

<div class="row g-3">

    @* ── Cập nhật trạng thái ─────────────────────────────────────────────────── *@
    <div class="col-12">
        <div class="card">
            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                <div>
                    <div class="text-secondary small">Trạng thái hiện tại</div>
                    <span class="badge @OrderStatusDisplay.BadgeClass(Model.Status) fs-4">
                        @OrderStatusDisplay.DisplayName(Model.Status)
                    </span>
                </div>

                <div class="ms-auto">
                    @* ADM-16: chỉ hiện đúng bước hợp lệ kế tiếp. Các nút dưới đây dựng từ state machine của
                       Core (OrderStatusRules) nên không bao giờ hiện một thao tác mà OrderService sẽ từ chối. *@
                    @if (Model.NextStatus is null && !Model.CanCancel)
                    {
                        <span class="text-secondary">
                            Đơn đang ở trạng thái kết thúc, không thể chuyển tiếp.
                        </span>
                    }
                    else
                    {
                        <div class="btn-list justify-content-end">
                            @if (Model.NextStatus is { } next)
                            {
                                <form asp-action="Advance" asp-route-id="@Model.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="target" value="@next" />
                                    <button type="submit" class="btn btn-primary">
                                        <i class="ti ti-arrow-right me-1"></i>@OrderStatusDisplay.ActionLabel(next)
                                    </button>
                                </form>
                            }

                            @if (Model.CanCancel)
                            {
                                @* Hủy đi qua action riêng vì OrderService phải hoàn trả tồn kho. *@
                                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Hủy đơn @Model.OrderCode? Tồn kho sẽ được hoàn trả. Thao tác này không thể hoàn tác.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger">
                                        <i class="ti ti-x me-1"></i>@OrderStatusDisplay.ActionLabel(OrderStatus.Cancelled)
                                    </button>
                                </form>
                            }
                        </div>
                        @if (Model.NextStatus is { } nextHint)
                        {
                            <div class="text-secondary small mt-2 text-end">
                                @OrderStatusDisplay.DisplayName(Model.Status) → @OrderStatusDisplay.DisplayName(nextHint)
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Thông tin đơn / khách / giao hàng ───────────────────────────────────── *@
    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h3 class="card-title">Đơn hàng</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-secondary fw-normal">Mã đơn</dt>
                    <dd class="col-7 font-monospace">@Model.OrderCode</dd>

                    <dt class="col-5 text-secondary fw-normal">Ngày đặt</dt>
                    <dd class="col-7">@Model.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</dd>

                    @if (Model.UpdatedAt is { } updatedAt)
                    {
                        <dt class="col-5 text-secondary fw-normal">Cập nhật</dt>
                        <dd class="col-7">@updatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</dd>
                    }

                    <dt class="col-5 text-secondary fw-normal">Tổng tiền</dt>
                    <dd class="col-7 mb-0"><strong>@Model.TotalAmount.ToVnd()</strong></dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h3 class="card-title">Khách hàng</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-secondary fw-normal">Tên tài khoản</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "(chưa đặt tên)" : Model.CustomerName)</dd>

                    <dt class="col-5 text-secondary fw-normal">Email</dt>
                    <dd class="col-7 text-break">@Model.CustomerEmail</dd>

                    <dt class="col-5 text-secondary fw-normal">Điện thoại</dt>
                    <dd class="col-7 mb-0">@(string.IsNullOrWhiteSpace(Model.CustomerPhone) ? "—" : Model.CustomerPhone)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h3 class="card-title">Giao hàng</h3></div>
            <div class="card-body">
                @* Toàn bộ khối này là snapshot lúc đặt hàng, không đọc lại sổ địa chỉ của khách. *@
                <dl class="row mb-0">
                    <dt class="col-5 text-secondary fw-normal">Người nhận</dt>
                    <dd class="col-7">@Model.ShippingFullName</dd>

                    <dt class="col-5 text-secondary fw-normal">Điện thoại</dt>
                    <dd class="col-7">@Model.ShippingPhone</dd>

                    <dt class="col-5 text-secondary fw-normal">Địa chỉ</dt>
                    <dd class="col-7">@Model.ShippingAddress</dd>

                    <dt class="col-5 text-secondary fw-normal">Ghi chú</dt>
                    <dd class="col-7 mb-0">@(string.IsNullOrWhiteSpace(Model.Note) ? "—" : Model.Note)</dd>
                </dl>
            </div>
        </div>
    </div>

    @* ── Dòng hàng ───────────────────────────────────────────────────────────── *@
    <div class="col-12">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Sản phẩm trong đơn</h3></div>
            <div class="table-responsive">
                @* Tên và giá lấy từ snapshot OrderDetail, không lấy Product.Name/Price hiện tại. *@
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Số lượng</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>
                                    @line.ProductName
                                    @if (line.ProductStillExists)
                                    {
                                        <a class="ms-2 small" asp-area="Admin" asp-controller="Product"
                                           asp-action="Edit" asp-route-id="@line.ProductId">xem sản phẩm</a>
                                    }
                                </td>
                                <td class="text-end text-nowrap">@line.UnitPrice.ToVnd()</td>
                                <td class="text-end">@line.Quantity</td>
                                <td class="text-end text-nowrap">@line.LineTotal.ToVnd()</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end text-secondary">Tiền hàng</td>
                            <td class="text-end text-nowrap">@Model.SubTotal.ToVnd()</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end text-secondary">Phí vận chuyển</td>
                            <td class="text-end text-nowrap">@Model.ShippingFee.ToVnd()</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end"><strong>Tổng cộng</strong></td>
                            <td class="text-end text-nowrap"><strong>@Model.TotalAmount.ToVnd()</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
