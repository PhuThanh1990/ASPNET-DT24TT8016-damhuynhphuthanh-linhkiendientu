@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Tổng quan cửa hàng";

    // Thẻ KPI dựng từ một mảng để 8 thẻ có cùng cấu trúc, không lặp markup 8 lần.
    var kpis = new (string Label, string Value, string Foot, string Icon, string Tone, bool Small)[]
    {
        ("Tổng đơn hàng", Model.Kpi.TotalOrders.ToString(), $"{Model.Kpi.CancelledOrders} đơn đã hủy", "ti-receipt", "bg-blue-lt", false),
        ("Chờ xác nhận", Model.Kpi.PendingOrders.ToString(), Model.Kpi.PendingOrders > 0 ? "Cần xử lý" : "Không có đơn nào chờ", "ti-clock", "bg-yellow-lt", false),
        ("Đơn hoàn tất", Model.Kpi.CompletedOrders.ToString(), "Cơ sở tính doanh thu", "ti-circle-check", "bg-green-lt", false),
        ("Doanh thu", Model.Kpi.TotalRevenue.ToVnd(), "Chỉ đơn hoàn tất, không tính đơn hủy", "ti-cash", "bg-green-lt", true),
        ("Sản phẩm", Model.Kpi.TotalProducts.ToString(), $"{Model.Kpi.ActiveProducts} đang bán", "ti-package", "bg-blue-lt", false),
        ("Hết hàng", Model.Kpi.OutOfStockProducts.ToString(), Model.Kpi.OutOfStockProducts > 0 ? "Cần nhập thêm" : "Tồn kho ổn định", "ti-alert-triangle", Model.Kpi.OutOfStockProducts > 0 ? "bg-red-lt" : "bg-green-lt", false),
        ("Khách hàng", Model.Kpi.TotalCustomers.ToString(), "Tài khoản có quyền Customer", "ti-users", "bg-blue-lt", false),
        ($"Doanh thu {Model.Revenue.Days} ngày", Model.Revenue.Total.ToVnd(), "Theo biểu đồ bên dưới", "ti-chart-line", "bg-azure-lt", true),
    };
}

@section PageActions {
    <a class="btn" asp-area="Admin" asp-controller="Order" asp-action="Index">
        <i class="ti ti-shopping-cart me-1"></i>Xem tất cả đơn hàng
    </a>
}

@* ───────── ADM-17: KPI cards ───────── *@
<div class="row row-cards mb-3">
    @foreach (var kpi in kpis)
    {
        <div class="col-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <span class="avatar @kpi.Tone me-3"><i class="ti @kpi.Icon"></i></span>
                        <div class="admin-min-w-0">
                            <div class="subheader">@kpi.Label</div>
                            <div class="admin-kpi-value @(kpi.Small ? "admin-kpi-value-sm" : null)">@kpi.Value</div>
                        </div>
                    </div>
                    <div class="text-secondary small mt-2">@kpi.Foot</div>
                </div>
            </div>
        </div>
    }
</div>

@* ───────── ADM-18: revenue over time ───────── *@
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">Doanh thu theo ngày</h3>
        <div class="card-actions">
            <div class="btn-list">
                @foreach (var option in RevenueChartViewModel.DayOptions)
                {
                    <a class="btn btn-sm @(Model.Revenue.Days == option ? "btn-primary" : "")"
                       asp-action="Index" asp-route-days="@option">@option ngày</a>
                }
            </div>
        </div>
    </div>

    @if (Model.Revenue.IsEmpty)
    {
        <div class="empty">
            <div class="empty-icon"><i class="ti ti-chart-line"></i></div>
            <p class="empty-title">Chưa có doanh thu trong @Model.Revenue.Days ngày gần đây</p>
            <p class="empty-subtitle text-secondary">
                Doanh thu chỉ được tính khi đơn hàng chuyển sang trạng thái
                <strong>@OrderStatusDisplay.DisplayName(Model.Revenue.RevenueStatus)</strong>.
            </p>
        </div>
    }
    else
    {
        <div class="card-body">
            <div class="admin-chart-wrap">
                <canvas id="revenueChart" aria-label="Biểu đồ doanh thu theo ngày" role="img"></canvas>
            </div>
        </div>
    }
</div>

<div class="row row-cards">
    @* ───────── ADM-19: best sellers ───────── *@
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title">Sản phẩm bán chạy</h3>
                <span class="card-subtitle ms-auto">Theo số lượng đã bán</span>
            </div>

            @if (Model.BestSellers.Count == 0)
            {
                <div class="empty">
                    <div class="empty-icon"><i class="ti ti-package"></i></div>
                    <p class="empty-title">Chưa có sản phẩm nào được bán</p>
                    <p class="empty-subtitle text-secondary">Chỉ tính các sản phẩm nằm trong đơn đã hoàn tất.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th colspan="2">Sản phẩm</th>
                                <th class="text-end">Đã bán</th>
                                <th class="text-end">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.BestSellers)
                            {
                                <tr>
                                    <td class="admin-cell-thumb">
                                        <img class="admin-thumb-sm"
                                             src="@DisplayHelper.ImageOrPlaceholder(product.ImageUrl)"
                                             alt="@product.ProductName" loading="lazy" />
                                    </td>
                                    <td class="admin-min-w-0">
                                        <a class="text-truncate d-block" asp-area="Admin" asp-controller="Product"
                                           asp-action="Edit" asp-route-id="@product.ProductId">@product.ProductName</a>
                                    </td>
                                    <td class="text-end">@product.QuantitySold</td>
                                    <td class="text-end text-nowrap">@product.Revenue.ToVnd()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ───────── ADM-19: recent orders ───────── *@
    <div class="col-12 col-xl-6">
        <div class="card h-100">
            <div class="card-header">
                <h3 class="card-title">Đơn hàng mới nhất</h3>
                <div class="card-actions">
                    <a class="btn btn-sm" asp-area="Admin" asp-controller="Order" asp-action="Index">Xem tất cả</a>
                </div>
            </div>

            @if (Model.RecentOrders.Count == 0)
            {
                <div class="empty">
                    <div class="empty-icon"><i class="ti ti-shopping-cart-off"></i></div>
                    <p class="empty-title">Chưa có đơn hàng nào</p>
                    <p class="empty-subtitle text-secondary">Đơn hàng của khách sẽ hiện ở đây.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Ngày đặt</th>
                                <th class="text-end">Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>
                                        <a class="font-monospace" asp-area="Admin" asp-controller="Order"
                                           asp-action="Details" asp-route-id="@order.Id">@order.OrderCode</a>
                                    </td>
                                    <td class="admin-min-w-0">
                                        <div class="text-truncate">
                                            @(string.IsNullOrWhiteSpace(order.CustomerName) ? "(chưa đặt tên)" : order.CustomerName)
                                        </div>
                                    </td>
                                    <td class="text-secondary text-nowrap">@order.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                    <td class="text-end text-nowrap">@order.TotalAmount.ToVnd()</td>
                                    <td>
                                        <span class="badge @OrderStatusDisplay.BadgeClass(order.Status)">
                                            @OrderStatusDisplay.DisplayName(order.Status)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* ───────── ADM-20: Chart.js ─────────
   Loaded only in this section, so the library ships with the dashboard and with no other
   Admin page. Skipped entirely when there is nothing to draw. *@
@if (!Model.Revenue.IsEmpty)
{
    @section Scripts {
        <script src="~/lib/chart.js/dist/chart.umd.min.js" asp-append-version="true"></script>
        <script>
            (function () {
                var canvas = document.getElementById('revenueChart');
                // Defensive: the canvas is only rendered when there is data, and the library
                // is vendored locally, but neither is worth a console error if it changes.
                if (!canvas || typeof Chart === 'undefined') {
                    return;
                }

                // Json.Serialize escapes <, > and & as \uXXXX, so this stays safe inside a
                // <script> block even if a label ever contains markup.
                var labels = @Json.Serialize(Model.Revenue.Labels);
                var values = @Json.Serialize(Model.Revenue.Values);

                var currency = new Intl.NumberFormat('vi-VN', {
                    style: 'currency', currency: 'VND', maximumFractionDigits: 0
                });

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Doanh thu',
                            data: values,
                            borderColor: '#0054a6',
                            backgroundColor: 'rgba(0, 84, 166, .12)',
                            borderWidth: 2,
                            pointRadius: values.length > 45 ? 0 : 3,
                            pointHoverRadius: 5,
                            tension: .3,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        return currency.format(context.parsed.y || 0);
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (value) {
                                        // Compact axis: 1.500.000 -> "1,5tr"
                                        if (value >= 1000000) { return (value / 1000000).toLocaleString('vi-VN') + 'tr'; }
                                        if (value >= 1000) { return (value / 1000).toLocaleString('vi-VN') + 'k'; }
                                        return value;
                                    }
                                }
                            },
                            x: { grid: { display: false } }
                        }
                    }
                });
            })();
        </script>
    }
}
