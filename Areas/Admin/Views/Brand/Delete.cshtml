@model BrandDeleteViewModel
@{
    ViewData["Title"] = "Xóa thương hiệu";
    ViewData["Subtitle"] = Model.Name;
}

@section PageActions {
    <a class="btn" asp-action="Index"><i class="ti ti-arrow-left me-1"></i>Quay lại danh sách</a>
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-7">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-secondary fw-normal">Tên</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                    <dt class="col-sm-4 text-secondary fw-normal">Slug</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary-lt font-monospace">@Model.Slug</span></dd>

                    <dt class="col-sm-4 text-secondary fw-normal">Số sản phẩm</dt>
                    <dd class="col-sm-8 mb-0">@Model.ProductCount</dd>
                </dl>
            </div>

            @if (Model.CanDelete)
            {
                <div class="card-body border-top">
                    <div class="alert alert-warning mb-0" role="alert">
                        <div class="d-flex">
                            <i class="ti ti-alert-triangle alert-icon me-2"></i>
                            <div>Bạn có chắc muốn xóa thương hiệu này? Thao tác không thể hoàn tác.</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Xóa vĩnh viễn thương hiệu &quot;@Model.Name&quot;?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="ti ti-trash me-1"></i>Xóa thương hiệu
                        </button>
                    </form>
                    <a class="btn btn-link" asp-action="Index">Hủy</a>
                </div>
            }
            else
            {
                <div class="card-body border-top">
                    <div class="alert alert-danger mb-0" role="alert">
                        <div class="d-flex">
                            <i class="ti ti-ban alert-icon me-2"></i>
                            <div>
                                <h4 class="alert-title">Không thể xóa thương hiệu này</h4>
                                <div class="text-secondary">
                                    Đang có @Model.ProductCount sản phẩm thuộc thương hiệu. Sản phẩm sẽ không bị xóa
                                    theo thương hiệu — hãy chuyển chúng sang thương hiệu khác, hoặc bỏ chọn
                                    "Đang hoạt động" ở màn hình sửa để ẩn thương hiệu.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Mở màn hình sửa</a>
                    <a class="btn btn-link" asp-action="Index">Quay lại danh sách</a>
                </div>
            }
        </div>
    </div>
</div>
