@model ProductDeleteViewModel
@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="admin-page-header">
    <h1>Xóa sản phẩm</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a>
</div>

<div class="admin-card">
    <dl class="row mb-4">
        <dt class="col-sm-3">Tên</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">SKU</dt>
        <dd class="col-sm-9"><code>@Model.Sku</code></dd>

        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive)
            {
                <span class="badge text-bg-success">Đang bán</span>
            }
            else
            {
                <span class="badge text-bg-secondary">Đã ngừng bán</span>
            }
        </dd>

        <dt class="col-sm-3">Đã bán trong</dt>
        <dd class="col-sm-9">@Model.OrderLineCount dòng đơn hàng</dd>

        <dt class="col-sm-3">Số ảnh</dt>
        <dd class="col-sm-9">@Model.ImageCount</dd>
    </dl>

    @if (Model.CanHardDelete)
    {
        <div class="alert alert-warning" role="alert">
            Sản phẩm này chưa từng được bán nên có thể xóa vĩnh viễn.
            Thao tác không thể hoàn tác và sẽ xóa luôn @Model.ImageCount file ảnh kèm theo.
            <div class="mt-2 mb-0">
                Nếu chỉ muốn ngừng bán, hãy dùng <strong>Ngừng bán</strong> ở danh sách — dữ liệu vẫn giữ nguyên.
            </div>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Xóa vĩnh viễn</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            <strong>Không thể xóa vĩnh viễn sản phẩm này.</strong>
            Sản phẩm đã xuất hiện trong @Model.OrderLineCount dòng đơn hàng. Xóa nó sẽ phá lịch sử
            đơn hàng, nên hệ thống chặn lại — đây cũng là ràng buộc <code>Restrict</code> ở database.
            <div class="mt-2 mb-0">Hãy dùng <strong>Ngừng bán</strong> để ẩn sản phẩm khỏi cửa hàng.</div>
        </div>

        <div class="d-flex gap-2">
            @if (Model.IsActive)
            {
                <form asp-action="Disable" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning">Ngừng bán</button>
                </form>
            }
            <a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a>
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Mở màn hình sửa</a>
        </div>
    }
</div>
