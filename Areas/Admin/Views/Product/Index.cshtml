@using ElectronicStore.Helpers
@model IReadOnlyList<ProductListItemViewModel>
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="admin-page-header">
    <h1>Sản phẩm</h1>
    <a class="btn btn-primary" asp-action="Create">+ Thêm sản phẩm</a>
</div>

<div class="admin-card">
    @if (Model.Count == 0)
    {
        <div class="admin-empty">
            <p class="mb-3">Chưa có sản phẩm nào.</p>
            <a class="btn btn-primary" asp-action="Create">Tạo sản phẩm đầu tiên</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Ảnh</th>
                        <th scope="col">Tên</th>
                        <th scope="col">SKU</th>
                        <th scope="col">Danh mục</th>
                        <th scope="col">Thương hiệu</th>
                        <th scope="col" class="text-end">Giá</th>
                        <th scope="col">Tồn kho</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Ngày tạo</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img class="admin-thumb" src="@DisplayHelper.ImageOrPlaceholder(item.PrimaryImageUrl)"
                                     alt="@item.Name" />
                            </td>
                            <td>@item.Name</td>
                            <td><code>@item.Sku</code></td>
                            <td>@item.CategoryName</td>
                            <td>@item.BrandName</td>
                            <td class="text-end text-nowrap">@item.Price.ToVnd()</td>
                            <td>
                                @* ADM-13: chỉnh nhanh tồn kho ngay tại danh sách. *@
                                <form asp-action="AdjustStock" asp-route-id="@item.Id" method="post"
                                      class="d-flex gap-1 align-items-center admin-stock-form">
                                    @Html.AntiForgeryToken()
                                    <input type="number" name="newQuantity" value="@item.StockQuantity"
                                           min="0" step="1" class="form-control form-control-sm"
                                           aria-label="Tồn kho của @item.Name" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Lưu</button>
                                </form>
                                @if (item.StockQuantity == 0)
                                {
                                    <span class="badge text-bg-warning mt-1">Hết hàng</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge text-bg-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Ngừng bán</span>
                                }
                            </td>
                            <td class="text-nowrap">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end text-nowrap">
                                <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Images" asp-route-id="@item.Id">Ảnh</a>

                                    @if (item.IsActive)
                                    {
                                        <form asp-action="Disable" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-warning"
                                                    title="Ẩn khỏi cửa hàng, giữ nguyên dữ liệu và lịch sử đơn">
                                                Ngừng bán
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success">Mở bán</button>
                                        </form>
                                    }

                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
