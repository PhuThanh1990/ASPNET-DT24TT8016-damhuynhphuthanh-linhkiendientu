@model IReadOnlyList<ProductListItemViewModel>
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="admin-page-header">
    <h1>Sản phẩm</h1>
    <a class="btn btn-primary" asp-action="Create">+ Thêm sản phẩm</a>
</div>

<div class="admin-card">
    @if (Model.Count == 0)
    {
        <div class="admin-empty">
            <p class="mb-3">Chưa có sản phẩm nào.</p>
            <a class="btn btn-primary" asp-action="Create">Tạo sản phẩm đầu tiên</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Ảnh</th>
                        <th scope="col">Tên</th>
                        <th scope="col">SKU</th>
                        <th scope="col">Danh mục</th>
                        <th scope="col">Thương hiệu</th>
                        <th scope="col" class="text-end">Giá</th>
                        <th scope="col" class="text-end">Tồn kho</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Ngày tạo</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.PrimaryImageUrl))
                                {
                                    <img class="admin-thumb" src="@item.PrimaryImageUrl" alt="@item.Name" />
                                }
                                else
                                {
                                    <span class="admin-thumb admin-thumb-empty">Chưa có</span>
                                }
                            </td>
                            <td>@item.Name</td>
                            <td><code>@item.Sku</code></td>
                            <td>@item.CategoryName</td>
                            <td>@item.BrandName</td>
                            <td class="text-end text-nowrap">@item.Price.ToString("N0") ₫</td>
                            <td class="text-end">
                                @if (item.StockQuantity == 0)
                                {
                                    <span class="badge text-bg-warning">Hết hàng</span>
                                }
                                else
                                {
                                    @item.StockQuantity
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge text-bg-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Đã ẩn</span>
                                }
                            </td>
                            <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end text-nowrap">
                                @* Sửa/Xóa sản phẩm thuộc task sau (không nằm trong ADM-08/09). *@
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                        title="Chức năng sửa sản phẩm thuộc task sau">
                                    Sửa
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" disabled
                                        title="Chức năng xóa sản phẩm thuộc task sau">
                                    Xóa
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
