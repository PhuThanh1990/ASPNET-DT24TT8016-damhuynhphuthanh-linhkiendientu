@model ProductCreateViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm";
    var hasCategories = Model.CategoryOptions.Any();
    var hasBrands = Model.BrandOptions.Any();
}

<div class="admin-page-header">
    <h1>Thêm sản phẩm</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a>
</div>

@if (!hasCategories || !hasBrands)
{
    <div class="alert alert-warning" role="alert">
        <strong>Chưa đủ dữ liệu để tạo sản phẩm.</strong>
        Mỗi sản phẩm bắt buộc phải thuộc một danh mục và một thương hiệu.
        @if (!hasCategories)
        {
            <a asp-controller="Category" asp-action="Create">Tạo danh mục trước</a>
            <text>. </text>
        }
        @if (!hasBrands)
        {
            <a asp-controller="Brand" asp-action="Create">Tạo thương hiệu trước</a>
            <text>. </text>
        }
    </div>
}

<div class="admin-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <partial name="_Form" model="Model" />

        <div class="alert alert-secondary mt-4 mb-0" role="alert">
            Ảnh sản phẩm được thêm sau khi tạo, ở màn hình <strong>Ảnh</strong> của sản phẩm.
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@(!hasCategories || !hasBrands)">
                Tạo sản phẩm
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
