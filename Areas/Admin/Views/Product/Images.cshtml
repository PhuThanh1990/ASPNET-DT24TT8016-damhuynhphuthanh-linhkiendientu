@model ProductImagesViewModel
@{
    ViewData["Title"] = "Ảnh sản phẩm";
    ViewData["Subtitle"] = Model.ProductName;
}

@section PageActions {
    <div class="btn-list">
        <a class="btn" asp-action="Edit" asp-route-id="@Model.ProductId">
            <i class="ti ti-pencil me-1"></i>Sửa sản phẩm
        </a>
        <a class="btn" asp-action="Index"><i class="ti ti-arrow-left me-1"></i>Quay lại danh sách</a>
    </div>
}

<div class="row g-3">
    <div class="col-12 col-xl-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Tải ảnh mới</h3>
            </div>
            @* enctype is required: without it the browser posts only the file name, not the bytes. *@
            <form asp-action="Images" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="File" class="form-label required"></label>
                        <input asp-for="File" type="file" class="form-control"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <span asp-validation-for="File" class="invalid-feedback d-block"></span>
                        <small class="form-hint">@ProductImagesViewModel.AllowedDescription</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AltText" class="form-label"></label>
                        <input asp-for="AltText" class="form-control" autocomplete="off"
                               placeholder="Để trống sẽ lấy tên sản phẩm" />
                        <span asp-validation-for="AltText" class="invalid-feedback d-block"></span>
                    </div>

                    <label class="form-check form-switch mb-0">
                        <input asp-for="IsPrimary" class="form-check-input" />
                        <span class="form-check-label">@Html.DisplayNameFor(m => m.IsPrimary)</span>
                    </label>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="ti ti-upload me-1"></i>Tải lên
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Ảnh hiện có</h3>
                <span class="card-subtitle ms-auto">@Model.Images.Count ảnh</span>
            </div>

            @if (Model.Images.Count == 0)
            {
                <div class="empty">
                    <div class="empty-icon"><i class="ti ti-photo"></i></div>
                    <p class="empty-title">Sản phẩm chưa có ảnh</p>
                    <p class="empty-subtitle text-secondary">
                        Ảnh đầu tiên tải lên sẽ tự động trở thành ảnh chính.
                    </p>
                </div>
            }
            else
            {
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var image in Model.Images)
                        {
                            <div class="col-6 col-md-4">
                                <div class="card h-100">
                                    <img src="@image.ImageUrl" class="card-img-top admin-image-tile"
                                         alt="@image.AltText" loading="lazy" />
                                    <div class="card-body p-2">
                                        @if (image.IsPrimary)
                                        {
                                            <span class="badge bg-success-lt mb-2">Ảnh chính</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-lt mb-2">Thứ tự @image.SortOrder</span>
                                        }
                                        <div class="text-secondary small text-truncate" title="@image.AltText">
                                            @(string.IsNullOrWhiteSpace(image.AltText) ? "(không có mô tả)" : image.AltText)
                                        </div>
                                    </div>
                                    <div class="card-footer p-2">
                                        <div class="btn-list">
                                            @if (!image.IsPrimary)
                                            {
                                                <form asp-action="SetPrimaryImage" asp-route-id="@Model.ProductId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="imageId" value="@image.Id" />
                                                    <button type="submit" class="btn btn-sm">Đặt làm chính</button>
                                                </form>
                                            }
                                            <form asp-action="DeleteImage" asp-route-id="@Model.ProductId" method="post"
                                                  onsubmit="return confirm('Xóa ảnh này khỏi sản phẩm?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="imageId" value="@image.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger btn-icon"
                                                        title="Xóa ảnh" aria-label="Xóa ảnh">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
