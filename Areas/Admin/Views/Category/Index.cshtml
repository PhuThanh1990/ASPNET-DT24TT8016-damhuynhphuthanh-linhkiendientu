@model IReadOnlyList<CategoryListItemViewModel>
@{
    ViewData["Title"] = "Danh mục";
    ViewData["Subtitle"] = Model.Count > 0 ? $"{Model.Count} danh mục" : null;
}

@section PageActions {
    <a class="btn btn-primary" asp-action="Create">
        <i class="ti ti-plus me-1"></i>Thêm danh mục
    </a>
}

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon"><i class="ti ti-category"></i></div>
            <p class="empty-title">Chưa có danh mục nào</p>
            <p class="empty-subtitle text-secondary">
                Danh mục giúp nhóm sản phẩm lại để khách dễ tìm.
            </p>
            <div class="empty-action">
                <a class="btn btn-primary" asp-action="Create">
                    <i class="ti ti-plus me-1"></i>Tạo danh mục đầu tiên
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>Slug</th>
                        <th>Danh mục cha</th>
                        <th class="text-end">Sản phẩm</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="w-1"><span class="visually-hidden">Thao tác</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="admin-min-w-0">
                                <div class="fw-semibold text-truncate">@item.Name</div>
                                <div class="text-secondary small">#@item.Id</div>
                            </td>
                            <td><span class="badge bg-secondary-lt font-monospace">@item.Slug</span></td>
                            <td class="text-secondary">@(item.ParentCategoryName ?? "—")</td>
                            <td class="text-end">@item.ProductCount</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-lt">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-lt">Đã ẩn</span>
                                }
                            </td>
                            <td class="text-secondary text-nowrap">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="btn-list flex-nowrap justify-content-end">
                                    <a class="btn btn-sm" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="ti ti-pencil me-1"></i>Sửa
                                    </a>
                                    @if (item.CanDelete)
                                    {
                                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">
                                            <i class="ti ti-trash me-1"></i>Xóa
                                        </a>
                                    }
                                    else
                                    {
                                        @* Không xóa được vì còn sản phẩm / danh mục con tham chiếu (khóa ngoại Restrict). *@
                                        <button type="button" class="btn btn-sm btn-outline-danger" disabled
                                                title="Đang có @item.ProductCount sản phẩm và @item.ChildCategoryCount danh mục con">
                                            <i class="ti ti-trash me-1"></i>Xóa
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
