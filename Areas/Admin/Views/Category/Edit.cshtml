@model CategoryFormViewModel
@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="admin-page-header">
    <h1>Sửa danh mục</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a>
</div>

<div class="admin-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
