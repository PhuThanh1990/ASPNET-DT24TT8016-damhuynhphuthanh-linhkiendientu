@model CategoryFormViewModel
@*
    Shared body of the Create and Edit forms. The anti-forgery token and the submit button
    live in the parent view so each screen keeps its own wording.
*@

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label required"></label>
        <input asp-for="Name" class="form-control" autocomplete="off" />
        <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Slug" class="form-label required"></label>
        <input asp-for="Slug" class="form-control" autocomplete="off" placeholder="vd: cpu-intel" />
        <span asp-validation-for="Slug" class="invalid-feedback d-block"></span>
        <small class="form-hint">Dùng trong URL. Tự động chuẩn hóa khi lưu: chữ thường, bỏ dấu, cách nhau bằng dấu "-".</small>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ParentCategoryId" class="form-label"></label>
        <select asp-for="ParentCategoryId" asp-items="Model.ParentCategoryOptions" class="form-select">
            <option value="">— Không có (danh mục gốc) —</option>
        </select>
        <span asp-validation-for="ParentCategoryId" class="invalid-feedback d-block"></span>
        <small class="form-hint">Để trống nếu đây là danh mục cấp cao nhất.</small>
    </div>

    <div class="col-md-3">
        <label asp-for="SortOrder" class="form-label"></label>
        <input asp-for="SortOrder" class="form-control" type="number" min="0" />
        <span asp-validation-for="SortOrder" class="invalid-feedback d-block"></span>
        <small class="form-hint">Số nhỏ hiện trước.</small>
    </div>

    <div class="col-md-3 d-flex align-items-center">
        <label class="form-check form-switch mb-0">
            <input asp-for="IsActive" class="form-check-input" />
            <span class="form-check-label">@Html.DisplayNameFor(m => m.IsActive)</span>
        </label>
    </div>

    <div class="col-12">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" autocomplete="off" placeholder="/images/categories/cpu.png" />
        <span asp-validation-for="ImageUrl" class="invalid-feedback d-block"></span>
        <small class="form-hint">Đường dẫn tương đối trong thư mục wwwroot.</small>
    </div>
</div>
