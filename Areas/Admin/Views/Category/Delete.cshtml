@model CategoryDeleteViewModel
@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="admin-page-header">
    <h1>Xóa danh mục</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a>
</div>

<div class="admin-card">
    <dl class="row mb-4">
        <dt class="col-sm-3">Tên</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Slug</dt>
        <dd class="col-sm-9"><code>@Model.Slug</code></dd>

        <dt class="col-sm-3">Số sản phẩm</dt>
        <dd class="col-sm-9">@Model.ProductCount</dd>

        <dt class="col-sm-3">Danh mục con</dt>
        <dd class="col-sm-9">@Model.ChildCategoryCount</dd>
    </dl>

    @if (Model.CanDelete)
    {
        <div class="alert alert-warning" role="alert">
            Bạn có chắc muốn xóa danh mục này? Thao tác không thể hoàn tác.
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Xóa danh mục</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            <strong>Không thể xóa danh mục này.</strong>
            Đang có @Model.ProductCount sản phẩm và @Model.ChildCategoryCount danh mục con tham chiếu tới nó.
            Sản phẩm sẽ không bị xóa theo danh mục. Hãy chuyển chúng sang danh mục khác,
            hoặc bỏ chọn "Đang hoạt động" ở màn hình sửa để ẩn danh mục.
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a>
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Mở màn hình sửa</a>
        </div>
    }
</div>
