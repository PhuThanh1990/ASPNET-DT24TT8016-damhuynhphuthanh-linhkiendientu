@model CategoryFormViewModel
@{
    ViewData["Title"] = "Thêm danh mục";
}

@section PageActions {
    <a class="btn" asp-action="Index"><i class="ti ti-arrow-left me-1"></i>Quay lại danh sách</a>
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-body">
                    <partial name="_Form" model="Model" />
                </div>
                <div class="card-footer d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Tạo danh mục</button>
                    <a class="btn btn-link" asp-action="Index">Hủy</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
