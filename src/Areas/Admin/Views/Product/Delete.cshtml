@model ProductDeleteViewModel
@{
    ViewData["Title"] = "Xóa sản phẩm";
    ViewData["Subtitle"] = Model.Name;
}

@section PageActions {
    <a class="btn" asp-area="Admin" asp-controller="Product" asp-action="Index"><i class="ti ti-arrow-left me-1"></i>Quay lại danh sách</a>
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-7">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-secondary fw-normal">Tên</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                    <dt class="col-sm-4 text-secondary fw-normal">SKU</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary-lt font-monospace">@Model.Sku</span></dd>

                    <dt class="col-sm-4 text-secondary fw-normal">Trạng thái</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-lt">Đang bán</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-lt">Đã ngừng bán</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-secondary fw-normal">Đã bán trong</dt>
                    <dd class="col-sm-8">@Model.OrderLineCount dòng đơn hàng</dd>

                    <dt class="col-sm-4 text-secondary fw-normal">Số ảnh</dt>
                    <dd class="col-sm-8 mb-0">@Model.ImageCount</dd>
                </dl>
            </div>

            @if (Model.CanHardDelete)
            {
                <div class="card-body border-top">
                    <div class="alert alert-warning mb-0" role="alert">
                        <div class="d-flex">
                            <i class="ti ti-alert-triangle alert-icon me-2"></i>
                            <div>
                                <h4 class="alert-title">Xóa vĩnh viễn sản phẩm này?</h4>
                                <div class="text-secondary">
                                    Sản phẩm chưa từng được bán nên có thể xóa hẳn. Thao tác không thể hoàn tác và
                                    sẽ xóa luôn @Model.ImageCount file ảnh kèm theo.
                                    Nếu chỉ muốn ngừng bán, hãy dùng <strong>Ngừng bán</strong> ở danh sách — dữ liệu vẫn giữ nguyên.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Xóa vĩnh viễn sản phẩm &quot;@Model.Name&quot; và toàn bộ ảnh của nó?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="ti ti-trash me-1"></i>Xóa vĩnh viễn
                        </button>
                    </form>
                    <a class="btn btn-link" asp-area="Admin" asp-controller="Product" asp-action="Index">Hủy</a>
                </div>
            }
            else
            {
                <div class="card-body border-top">
                    @* OrderDetail.ProductId là Restrict: xóa sản phẩm đã bán sẽ phá lịch sử đơn. *@
                    <div class="alert alert-danger mb-0" role="alert">
                        <div class="d-flex">
                            <i class="ti ti-ban alert-icon me-2"></i>
                            <div>
                                <h4 class="alert-title">Không thể xóa vĩnh viễn sản phẩm này</h4>
                                <div class="text-secondary">
                                    Sản phẩm đã xuất hiện trong @Model.OrderLineCount dòng đơn hàng. Xóa nó sẽ phá
                                    lịch sử đơn hàng, nên hệ thống chặn lại — đây cũng là ràng buộc
                                    <code>Restrict</code> ở database. Hãy dùng <strong>Ngừng bán</strong> để ẩn sản phẩm
                                    khỏi cửa hàng.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex flex-wrap gap-2">
                    @if (Model.IsActive)
                    {
                        <form asp-action="Disable" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Ngừng bán &quot;@Model.Name&quot;?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning">
                                <i class="ti ti-eye-off me-1"></i>Ngừng bán
                            </button>
                        </form>
                    }
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Mở màn hình sửa</a>
                    <a class="btn btn-link" asp-area="Admin" asp-controller="Product" asp-action="Index">Quay lại danh sách</a>
                </div>
            }
        </div>
    </div>
</div>
