@{
    var statusCode = ViewData["StatusCode"] as int? ?? 404;

    // Mỗi mã lỗi có một thông điệp riêng. Không mã nào in ra chi tiết kỹ thuật.
    var (icon, heading, message) = statusCode switch
    {
        400 => ("⚠️", "Yêu cầu không hợp lệ", "Đường dẫn hoặc dữ liệu gửi lên không đúng định dạng. Vui lòng thử lại."),
        403 => ("🔒", "Bạn không có quyền xem trang này", "Tài khoản hiện tại không được phép mở nội dung này."),
        404 => ("🔍", "Không tìm thấy trang", "Trang hoặc sản phẩm bạn tìm không tồn tại, hoặc đã ngừng kinh doanh."),
        _ when statusCode >= 500 => ("⚠️", "Hệ thống đang gặp sự cố", "Rất tiếc, đã có lỗi xảy ra khi xử lý yêu cầu. Vui lòng thử lại sau ít phút."),
        _ => ("⚠️", "Đã có lỗi xảy ra", "Yêu cầu của bạn không hoàn tất được. Vui lòng thử lại."),
    };

    ViewData["Title"] = heading;
}

<div class="container">
    <div class="empty-state my-5">
        <div class="empty-icon">@icon</div>
        <p class="error-code">Lỗi @statusCode</p>
        <h1 class="h4 text-body mb-2">@heading</h1>
        <p class="mb-4">@message</p>

        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
            <a class="btn btn-outline-secondary" asp-controller="Product" asp-action="Index">Xem sản phẩm</a>
        </div>
    </div>
</div>
