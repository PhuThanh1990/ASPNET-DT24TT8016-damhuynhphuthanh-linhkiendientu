@model int
@*
    CUS-12 / UI-02 — nút giỏ hàng trên header. Model là tổng số lượng lấy từ Session
    (không chạm database). Giỏ rỗng vẫn hiện số 0 nhưng ở dạng trung tính.
*@
<a class="header-action cart-link" asp-area="" asp-controller="Cart" asp-action="Index"
   aria-label="Giỏ hàng, @Model sản phẩm">
    <i class="ti ti-shopping-cart header-action__icon" aria-hidden="true"></i>
    <span class="header-action__label">Giỏ hàng</span>
    <span class="cart-link__badge @(Model > 0 ? null : "is-empty")" aria-hidden="true">@Model</span>
</a>
