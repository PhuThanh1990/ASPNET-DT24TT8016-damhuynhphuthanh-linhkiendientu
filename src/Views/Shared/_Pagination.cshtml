@model ProductListViewModel
@*
    CUS-11 — thanh phân trang. Mọi link đều đi qua Model.RouteValues(page) nên keyword,
    filter và sort hiện tại luôn được giữ lại trên URL.
*@
@if (Model.TotalPages > 1)
{
    var pages = Model.PageNumbers.ToList();

    <nav aria-label="Phân trang sản phẩm" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap mb-0">

            <li class="page-item @(Model.HasPreviousPage ? null : "disabled")">
                <a class="page-link" asp-controller="Product" asp-action="Index"
                   asp-all-route-data="@Model.RouteValues(Math.Max(1, Model.CurrentPage - 1))"
                   aria-label="Trang trước">&laquo;</a>
            </li>

            @if (pages.Count > 0 && pages[0] > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-controller="Product" asp-action="Index"
                       asp-all-route-data="@Model.RouteValues(1)">1</a>
                </li>
                @if (pages[0] > 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }

            @foreach (var pageNumber in pages)
            {
                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : null)">
                    <a class="page-link" asp-controller="Product" asp-action="Index"
                       asp-all-route-data="@Model.RouteValues(pageNumber)">@pageNumber</a>
                </li>
            }

            @if (pages.Count > 0 && pages[^1] < Model.TotalPages)
            {
                @if (pages[^1] < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item">
                    <a class="page-link" asp-controller="Product" asp-action="Index"
                       asp-all-route-data="@Model.RouteValues(Model.TotalPages)">@Model.TotalPages</a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? null : "disabled")">
                <a class="page-link" asp-controller="Product" asp-action="Index"
                   asp-all-route-data="@Model.RouteValues(Math.Min(Model.TotalPages, Model.CurrentPage + 1))"
                   aria-label="Trang sau">&raquo;</a>
            </li>

        </ul>
    </nav>
}
